# Zig
.zig-cache/
.zig-cache-global/
zig-cache/
zig-out/
# Zig 0.16 unpacks fetched packages here.
zig-pkg/

# Build outputs
build/
# The top-level build/ holds Zig sources that build.zig imports, so it is
# not generated output and must stay tracked. Generated CMake output does
# land in there though, so exclude that explicitly.
!/build/
/build/CMakeLists.txt
/build/Debug/
/build/Release/

# Generated by whichever CMake example built last, so it is never a
# meaningful diff.
/CMakeLists.txt
bin/
dist/
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb
*.pcm

# Dependencies
deps/

# IDE
.vscode/
.idea/

# OS specific
.DS_Store
Thumbs.db

# Zig installation
zig-linux-x86_64-0.11.0/
zig-linux-x86_64-0.11.0.tar.xz

# Env / local tooling
.envrc

# Example-local caches
examples/**/.zig-cache/
examples/**/zig-out/

# Scratch projects generated by benchmarks/build_bench.zig
benchmarks/.workspace/

# Local web / generated staging
www/

# Cargo build output (Rust interop example)
**/rust_lib/target/

# Local toolchain shims: these hardcode an absolute path to one machine.
/zig
/zig-build

# zaza-drive build output
/tools/zaza-drive/zaza-drive
/tools/zaza-drive/zdrive
/tools/zaza-drive/.zaza-drive/
/.zaza-drive-native/
# Output of running the driver from the repo root (the `zig build drive` demo)
/.zaza-drive/
/hello_zaza_cpp
